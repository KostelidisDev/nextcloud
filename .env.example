# Nextcloud stack — keep this file out of git (chmod 600 .env)

# Required
DOMAIN=cloud.example.com
# Must match the existing database user's password
POSTGRES_PASSWORD=nextcloud
REDIS_PASSWORD=nextcloud

# Data directory on an SMB/NFS share
DATA_MOUNT_TYPE=cifs
DATA_MOUNT_DEVICE=//127.0.0.1/nextcloud
DATA_MOUNT_O=addr=127.0.0.1,username=u,password=p,vers=3.1.1,iocharset=utf8,seal,uid=33,gid=33,file_mode=0770,dir_mode=0770

# Image versions — pin exact releases, nextcloud and cron always identical.
# Upgrade Nextcloud one major at a time.
NEXTCLOUD_VERSION=35.0.1-apache
POSTGRES_TAG=18.6-alpine
REDIS_TAG=8.10-alpine3.23

# Database identity — must match the existing database
POSTGRES_DB=nextcloud
POSTGRES_USER=nextcloud

# Network subnets (IPv4 + IPv6). Pick ranges that don't overlap your LAN or
# other Docker networks: docker network inspect -f '{{range .IPAM.Config}}{{.Subnet}} {{end}}' $(docker network ls -q)
# Frontend "nextcloud" network — both subnets are Nextcloud's trusted proxies
# (host-network Traefik connects from their gateways).
NEXTCLOUD_NETWORK_SUBNET_V4=10.100.0.0/24
NEXTCLOUD_NETWORK_SUBNET_V6=fd00:100:0::/64
# Internal "nextcloud-backend" network (Nextcloud, cron, Postgres, Redis)
BACKEND_NETWORK_SUBNET_V4=10.100.1.0/24
BACKEND_NETWORK_SUBNET_V6=fd00:100:1::/64

# Access control
IPV4_ALLOWLIST=0.0.0.0/0
IPV6_ALLOWLIST=::/0

# PHP / Apache
PHP_MEMORY_LIMIT=1G
PHP_UPLOAD_LIMIT=16G
# Peak memory ≈ MAX_WORKERS x typical request memory (~100M). Keep within NEXTCLOUD_MEMORY_LIMIT.
NEXTCLOUD_MAX_WORKERS=16
# Keep below REDIS_MEMORY_LIMIT
REDIS_MAXMEMORY=200mb

# Optional overrides
TZ=Europe/Athens
NEXTCLOUD_CPU_LIMIT=2
NEXTCLOUD_MEMORY_LIMIT=2G
NEXTCLOUD_MEMORY_RESERVATION=512M
NEXTCLOUD_PIDS_LIMIT=512
CRON_CPU_LIMIT=0.5
CRON_MEMORY_LIMIT=512M
CRON_MEMORY_RESERVATION=128M
CRON_PIDS_LIMIT=128
DB_CPU_LIMIT=1
DB_MEMORY_LIMIT=1G
DB_MEMORY_RESERVATION=256M
DB_PIDS_LIMIT=256
REDIS_CPU_LIMIT=0.5
REDIS_MEMORY_LIMIT=256M
REDIS_MEMORY_RESERVATION=64M
REDIS_PIDS_LIMIT=64